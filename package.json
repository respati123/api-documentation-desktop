{
  "name": "api-documentation-bit",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite --noSandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview --noSandbox",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "biome check src",
    "format": "biome check --write src",
    "dist": "bun run build && electron-builder",
    "dist:linux": "bun run build && electron-builder --linux",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:win": "bun run build && electron-builder --win"
  },
  "build": {
    "appId": "dev.apidocs.desktop",
    "productName": "API Documentation",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "API Documentation",
        "schemes": [
          "api-docs"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "deb": {
      "maintainer": "API Documentation <no-reply@example.test>"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "respati123",
        "repo": "api-documentation-desktop",
        "releaseType": "release"
      }
    ],
    "artifactName": "api-documentation-${version}.${ext}"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "lucide-react": "^1.59.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.9",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "electron": "^39.2.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "description": "API documentation and request workspace",
  "author": {
    "name": "API Documentation",
    "email": "no-reply@example.test"
  },
  "homepage": "https://example.test"
}
